# Kopier denne filen til .env og fyll inn verdiene (Start Sigarsjefen gjør det for deg).
# .env skal ALDRI pushes til GitHub (den står i .gitignore).

# --- Capital.com ---
# demo = lekepenger (start her), live = ekte penger
CAPITAL_ENV=demo
# Lag API-nøkkel i Capital.com: Innstillinger -> API integrations -> Generate new key.
# Krever at tofaktor-innlogging (2FA) er slått på.
CAPITAL_API_KEY=
# E-posten du logger inn på Capital.com med
CAPITAL_IDENTIFIER=
# Passordet du valgte da du laget API-nøkkelen (ikke nødvendigvis innloggingspassordet)
CAPITAL_API_PASSWORD=

# --- Markeder ---
# US100 = Nasdaq-100 (NQ), US500 = S&P 500 (ES), GOLD = gull (GC), OIL_CRUDE = olje (CL)
MARKETS=US100,US500,GOLD,OIL_CRUDE

# --- Strategi: opening range breakout ---
# Hvor mange minutter etter åpning range bygges (15 eller 30 er vanlig)
ORB_MINUTES=15
# Ingen nye handler senere enn så mange minutter etter åpning
ENTRY_CUTOFF_MINUTES=120
# Mål = så mange ganger risikoen (2 = mål dobbelt så langt unna som stop)
REWARD_RISK=2
# Lukk alt så mange minutter før sesjonen slutter
FLAT_BEFORE_CLOSE_MINUTES=15
# Hopp over dager med for smal eller for bred range (prosent av prisen)
MIN_RANGE_PCT=0.05
MAX_RANGE_PCT=1.5

# --- Risiko ---
# Hvor mye av kontoen du taper hvis stop-loss treffes (0.5 = en halv prosent)
RISK_PER_TRADE_PCT=0.5
# Stopp all ny handel resten av dagen når dagens tap når denne prosenten
DAILY_LOSS_LIMIT_PCT=2
# Maks antall handler per dag (totalt for alle markeder)
MAX_TRADES_PER_DAY=3

# --- Backtest ---
# Hvor mange dager bakover npm run backtest tester
BACKTEST_DAYS=60

# --- Læring ---
# Boten tester nye innstillinger hver natt og tar dem i bruk bare hvis de er tydelig bedre
LEARN_ENABLED=true
# Hvor mange dager bakover læringen ser
LEARN_DAYS=90

# --- Dashboard ---
# Nettside som viser hva boten gjør: http://localhost:3000 (bare fra denne PC-en)
WEB_ENABLED=true
WEB_PORT=3000

# Sekunder mellom hver runde
LOOP_SECONDS=20
