# Kopier denne filen til .env og fyll inn verdiene.
# .env skal ALDRI pushes til GitHub (den står i .gitignore).

# --- Sikkerhetsbryter ---
# true = boten later som den handler (ingen ekte penger brukes).
# Sett til false først når du har sett at strategien fungerer.
DRY_RUN=true

# --- Solana ---
# RPC-adresse. Den gratis offentlige fungerer for testing, men er treg og har lave grenser.
# Anbefalt: gratis konto hos Helius (helius.dev) eller QuickNode.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Private key til BOT-walleten (base58). Bruk en egen wallet med lite penger.
# Trengs bare når DRY_RUN=false.
BOT_WALLET_PRIVATE_KEY=

# --- Risikoregler ---
# Maks SOL per handel
MAX_SOL_PER_TRADE=0.1
# Stopp all handel når dagens tap når denne prosenten av startsaldo
DAILY_LOSS_LIMIT_PCT=5
# Maks antall åpne posisjoner samtidig
MAX_OPEN_POSITIONS=3
# Standard stop-loss i prosent
STOP_LOSS_PCT=20
# Ta gevinst i prosent
TAKE_PROFIT_PCT=50
# Startsaldo i SOL for simulering (brukes når DRY_RUN=true)
PAPER_START_SOL=1

# --- Sikkerhetssjekk av tokens ---
# Minste sikkerhetsscore (0-100) for at en token kan kjøpes
MIN_SAFETY_SCORE=70
# Minste likviditet i USD
MIN_LIQUIDITY_USD=15000
# Maks andel (%) topp-10 holdere kan eie
MAX_TOP10_HOLDER_PCT=30

# --- Kommer senere ---
FOMO_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
