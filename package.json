{
  "name": "sigarsjefen-tradingbot",
  "version": "0.1.0",
  "private": true,
  "description": "Solana memecoin-bot: skanner, sikkerhetssjekk, copytrade og risikostyring",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "check": "tsx src/cli/check.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "wallet": "tsx src/cli/wallet.ts",
    "wallet:new": "tsx src/cli/wallet.ts new",
    "swaptest": "tsx src/cli/swapTest.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
